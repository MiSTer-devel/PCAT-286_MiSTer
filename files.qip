# Quartus source manifest for the single PCAT-286 AT profile.
set_global_assignment -name SDC_FILE SYSTEM.sdc
set_global_assignment -name QIP_FILE rtl/pll.qip
set_global_assignment -name QIP_FILE rtl/common/common.qip
set_global_assignment -name QIP_FILE rtl/video/video.qip
set_global_assignment -name QIP_FILE rtl/uart/uart.qip
set_global_assignment -name QIP_FILE rtl/spk286_integration/spk286_integration.qip

# AdLib/OPL2, Sound Blaster Pro, C/MS and Tandy SN76489 audio.
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/sound/soundblaster.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/sound/sb_dsp.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/sound/sb_mixer.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/sound/sb_volume.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/sound/sb_dma_glue.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/sound/saa1099.sv"
set_global_assignment -name QIP_FILE rtl/sound/jtopl/hdl/jtopl2.qip
set_global_assignment -name QIP_FILE rtl/sound/jt89/hdl/jt89.qip

# AT storage and the PC speaker path.
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/hps_ext.v"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KFSDRAM/HDL/KFSDRAM.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8259/HDL/KF8259_Priority_Resolver.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8259/HDL/KF8259_Interrupt_Request.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8259/HDL/KF8259_In_Service.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8259/HDL/KF8259_Control_Logic.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8259/HDL/KF8259_Bus_Control_Logic.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8259/HDL/KF8259.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8253/HDL/KF8253_Counter.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8253/HDL/KF8253_Control_Logic.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/KF8253/HDL/KF8253.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/ega_vram_bram_frontend.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/ega_bios_loaded_latch.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "rtl/KFPC-XT/HDL/rom_presence_latch.sv"
